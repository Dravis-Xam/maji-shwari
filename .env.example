# Neon pooled connection string
DATABASE_URL=

# Protects manual calls to /api/cron/reconcile
CRON_SECRET=

# Long random secret used to sign role sessions
JWT_SECRET=

# Google OAuth web client settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/auth/google

# Comma-separated approved accounts. Role is assigned by server-side allowlist.
GOOGLE_COMMUNITY_EMAILS=
GOOGLE_GOVERNMENT_EMAILS=
GOOGLE_DONOR_EMAILS=