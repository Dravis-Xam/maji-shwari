# Copy this file to .env (local) or set these in Vercel → Project Settings → Environment Variables.
# Never commit a real .env file — only this example with placeholder values.

# --- Sessions (required) ---------------------------------------------------
# Long random string used to sign session, pending, and verification cookies.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# --- Google OAuth (required for real sign-in) ------------------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match an "Authorized redirect URI" on that OAuth client.
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/auth/google

# --- Email verification (optional — falls back to demo mode) --------------
# If either of these is missing, the app logs the 6-digit code to the
# function's console and returns it as `demoCode` in the API response instead
# of emailing it, so you can still test the flow without setting these up.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=MajiShwari <noreply@your-domain.com>

# --- Database (optional — falls back to demo data) -------------------------
# Neon pooled connection string. Without it, reads/writes use non-persistent
# in-memory demo data instead of Postgres.
DATABASE_URL=postgresql://user:password@ep-example-12345.region.aws.neon.tech/dbname?sslmode=require

# --- Cron (optional) --------------------------------------------------------
# Only needed if you want to protect manual calls to /api/cron/reconcile.
# Vercel automatically sends this header for the scheduled cron job itself.
CRON_SECRET=another-long-random-string

# --- Set automatically by Vercel, no action needed --------------------------
# NODE_ENV=production

#----Pusher -> for notifications ----------------------

PUSHER_APP_ID=your pusher app id
PUSHER_KEY=your pusher app key
PUSHER_SECRET=your pusher app secret
PUSHER_CLUSTER=your pusher app cluster
