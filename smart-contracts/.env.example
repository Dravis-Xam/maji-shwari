# Copy to .env in this directory. Never commit a real .env file.

# --- Deployment (required for polygonAmoy / polygonPos networks) ----------
# Private key of the wallet that pays gas and deploys the contract.
# Use a dedicated deploy wallet, never a personal or treasury key.
PRIVATE_KEY_DEPLOYER=

# Comma-separated approver addresses for scripts/deploy_prod.ts — the
# wallets (e.g. a county signer, a donor signer) authorized to propose and
# approve releases on AuditLedger from day one.
AUDIT_LEDGER_APPROVERS=0xYourCountySignerAddress,0xYourDonorSignerAddress

# Releases at or above this amount (KES cents) require a second approver.
# 500000 KES => 50000000 cents (the default used in deploy_prod.ts if unset).
AUDIT_LEDGER_THRESHOLD_CENTS=50000000

# --- RPC endpoints (optional — sensible public defaults are already set in
# hardhat.config.ts; override if you have your own Alchemy/Infura/QuickNode
# endpoint for better reliability) --------------------------------------
POLYGON_AMOY_RPC_URL=
POLYGON_POS_RPC_URL=

# --- Contract verification (optional) --------------------------------------
# From https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=

# --- Ethernal local block explorer (optional) ------------------------------
# Create an account/workspace at https://app.tryethernal.com/
ETHERNAL_EMAIL=
ETHERNAL_PASSWORD=
ETHERNAL_WORKSPACE=MajiShwari
